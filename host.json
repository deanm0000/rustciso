{
  "version": "2.0",
  "logging": {
    "fileLoggingMode": "always",
    "logLevel": { "default": "Information" },
    "console": { "isEnabled": true, "DisableColors": true },
    "applicationInsights": {
      "samplingSettings": { "isEnabled": true, "excludedTypes": "Request" }
    }
  },
  "extensionBundle": {
    "id": "Microsoft.Azure.Functions.ExtensionBundle",
    "version": "[4.*, 5.0.0)"
  },
  "extensions": {
    "queues": { "batchSize": 1, "newBatchThreshold": 0, "maxDequeueCount": 1 }
  },
  "customHandler": {
    "description": {
      "defaultExecutablePath": "target/x86_64-unknown-linux-musl/release/rustciso",
      "workingDirectory": "",
      "arguments": []
    },
    "enableForwardingHttpRequest": false
  },
  "concurrency": { "dynamicConcurrencyEnabled": false, "snapshotPersistenceEnabled": false },
  "functionTimeout": "-1"
}
